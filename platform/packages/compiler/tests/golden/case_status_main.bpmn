<bpmn:error id="Error_CLOSED" name="CLOSED" errorCode="CLOSED" />
<bpmn:process id="zm_t__store_launch" name="Store launch" isExecutable="true" operaton:candidateStarterGroups="bd__L1,bd__L2">
<bpmn:startEvent id="start" name="New site" operaton:formKey="zm:start" operaton:initiator="initiator"><bpmn:extensionElements><operaton:executionListener event="start" expression="${execution.setVariable('stage', 'Created')}" /><operaton:executionListener event="start" expression="${execution.setVariable('case_status', 'open')}" /></bpmn:extensionElements></bpmn:startEvent>
<bpmn:callActivity id="call_bd" name="BD" calledElement="zm_t__store_launch__bd" operaton:calledElementBinding="deployment"><bpmn:extensionElements><operaton:executionListener event="start" expression="${execution.setVariable('stage', 'BD')}" /><operaton:executionListener event="start" expression="${execution.setVariable('m_bd', 'in progress')}" /><operaton:executionListener event="end" expression="${execution.setVariable('m_bd', 'done')}" /><operaton:in businessKey="#{execution.processBusinessKey}" /><operaton:in variables="all" /><operaton:out variables="all" /></bpmn:extensionElements></bpmn:callActivity>
<bpmn:boundaryEvent id="closed_bd" name="Closed" attachedToRef="call_bd"><bpmn:errorEventDefinition errorRef="Error_CLOSED" /></bpmn:boundaryEvent>
<bpmn:endEvent id="closed_bd_end" name="Closed in BD"><bpmn:extensionElements><operaton:executionListener event="start" expression="${execution.setVariable('stage', 'Closed in BD')}" /><operaton:executionListener event="start" expression="${execution.setVariable('case_status', 'closed:bd')}" /></bpmn:extensionElements><bpmn:terminateEventDefinition /></bpmn:endEvent>
<bpmn:callActivity id="call_legal" name="Legal" calledElement="zm_t__store_launch__legal" operaton:calledElementBinding="deployment"><bpmn:extensionElements><operaton:executionListener event="start" expression="${execution.setVariable('stage', 'Legal')}" /><operaton:executionListener event="start" expression="${execution.setVariable('m_legal', 'in progress')}" /><operaton:executionListener event="end" expression="${execution.setVariable('m_legal', 'done')}" /><operaton:in businessKey="#{execution.processBusinessKey}" /><operaton:in variables="all" /><operaton:out variables="all" /></bpmn:extensionElements></bpmn:callActivity>
<bpmn:boundaryEvent id="closed_legal" name="Closed" attachedToRef="call_legal"><bpmn:errorEventDefinition errorRef="Error_CLOSED" /></bpmn:boundaryEvent>
<bpmn:endEvent id="closed_legal_end" name="Closed in Legal"><bpmn:extensionElements><operaton:executionListener event="start" expression="${execution.setVariable('stage', 'Closed in Legal')}" /><operaton:executionListener event="start" expression="${execution.setVariable('case_status', 'closed:legal')}" /></bpmn:extensionElements><bpmn:terminateEventDefinition /></bpmn:endEvent>
<bpmn:endEvent id="completed_end" name="Completed"><bpmn:extensionElements><operaton:executionListener event="start" expression="${execution.setVariable('stage', 'Completed')}" /><operaton:executionListener event="start" expression="${execution.setVariable('case_status', 'completed')}" /></bpmn:extensionElements></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="call_bd" />
<bpmn:sequenceFlow id="f2" sourceRef="closed_bd" targetRef="closed_bd_end" />
<bpmn:sequenceFlow id="f3" sourceRef="call_bd" targetRef="call_legal" />
<bpmn:sequenceFlow id="f4" sourceRef="closed_legal" targetRef="closed_legal_end" />
<bpmn:sequenceFlow id="f5" sourceRef="call_legal" targetRef="completed_end" />
</bpmn:process>
