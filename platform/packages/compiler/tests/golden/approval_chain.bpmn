<bpmn:startEvent id="start" name="Start"></bpmn:startEvent>
<bpmn:endEvent id="done" name="Done"></bpmn:endEvent>
<bpmn:userTask id="qsr_licences" name="Statutory licences" operaton:formKey="zm:qsr_licences" operaton:candidateGroups="legal__L1,legal__L2,legal__L3"></bpmn:userTask>
<bpmn:userTask id="qsr_licences__appr_legal_L2" name="Statutory licences: Legal &amp; Statutory L2 approval" operaton:formKey="zm:qsr_licences__appr_legal_L2" operaton:candidateGroups="legal__L2"></bpmn:userTask>
<bpmn:exclusiveGateway id="qsr_licences__appr_legal_L2_gw" />
<bpmn:endEvent id="qsr_licences__appr_legal_L2_reject_end" name="Closed"><bpmn:errorEventDefinition errorRef="Error_CLOSED" /></bpmn:endEvent>
<bpmn:userTask id="qsr_licences__appr_legal_L3" name="Statutory licences: Legal &amp; Statutory L3 approval" operaton:formKey="zm:qsr_licences__appr_legal_L3" operaton:candidateGroups="legal__L3"></bpmn:userTask>
<bpmn:exclusiveGateway id="qsr_licences__appr_legal_L3_gw" />
<bpmn:endEvent id="qsr_licences__appr_legal_L3_reject_end" name="Closed"><bpmn:errorEventDefinition errorRef="Error_CLOSED" /></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="qsr_licences" />
<bpmn:sequenceFlow id="f2" sourceRef="qsr_licences" targetRef="qsr_licences__appr_legal_L2" />
<bpmn:sequenceFlow id="f3" sourceRef="qsr_licences__appr_legal_L2" targetRef="qsr_licences__appr_legal_L2_gw" />
<bpmn:sequenceFlow id="f4" sourceRef="qsr_licences__appr_legal_L2_gw" targetRef="qsr_licences__appr_legal_L3" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qsr_licences__appr_legal_L2_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f5" sourceRef="qsr_licences__appr_legal_L2_gw" targetRef="qsr_licences" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qsr_licences__appr_legal_L2_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" sourceRef="qsr_licences__appr_legal_L2_gw" targetRef="qsr_licences__appr_legal_L2_reject_end" name="Reject"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qsr_licences__appr_legal_L2_outcome == 'reject'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f7" sourceRef="qsr_licences__appr_legal_L3" targetRef="qsr_licences__appr_legal_L3_gw" />
<bpmn:sequenceFlow id="f8" sourceRef="qsr_licences__appr_legal_L3_gw" targetRef="done" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qsr_licences__appr_legal_L3_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f9" sourceRef="qsr_licences__appr_legal_L3_gw" targetRef="qsr_licences" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qsr_licences__appr_legal_L3_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
