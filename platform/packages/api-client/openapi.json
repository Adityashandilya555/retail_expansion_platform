{
  "components": {
    "schemas": {
      "CaseIn": {
        "properties": {
          "flow": {
            "description": "Key of one of the workflow's flows.",
            "title": "Flow",
            "type": "string"
          },
          "values": {
            "additionalProperties": true,
            "default": {},
            "description": "The flow's start form, field key \u2192 value.",
            "title": "Values",
            "type": "object"
          }
        },
        "required": [
          "flow"
        ],
        "title": "CaseIn",
        "type": "object"
      },
      "CaseOut": {
        "properties": {
          "code": {
            "description": "e.g. `MX-0001`; also the Operaton business key.",
            "title": "Code",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "flow": {
            "title": "Flow",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "process_instance_id": {
            "title": "Process Instance Id",
            "type": "string"
          },
          "release_version": {
            "title": "Release Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "code",
          "flow",
          "release_version",
          "process_instance_id",
          "created_at"
        ],
        "title": "CaseOut",
        "type": "object"
      },
      "ClientInfo": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "title": "ClientInfo",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "description": "JSON Pointer to the field, e.g. `/ca_amount`.",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "FormOut": {
        "properties": {
          "layout": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Layout",
            "type": "array"
          },
          "schema": {
            "additionalProperties": true,
            "description": "JSON Schema 2020-12 for the submission, without sections hidden from this user.",
            "title": "Schema",
            "type": "object"
          }
        },
        "required": [
          "schema",
          "layout"
        ],
        "title": "FormOut",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "workspace_code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Workspace Code",
            "type": "string"
          }
        },
        "required": [
          "workspace_code",
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "Me": {
        "properties": {
          "client": {
            "$ref": "#/components/schemas/ClientInfo"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_client_admin": {
            "title": "Is Client Admin",
            "type": "boolean"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/Membership"
            },
            "title": "Memberships",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "is_client_admin",
          "client",
          "memberships"
        ],
        "title": "Me",
        "type": "object"
      },
      "Membership": {
        "properties": {
          "department": {
            "title": "Department",
            "type": "string"
          },
          "level": {
            "title": "Level",
            "type": "integer"
          },
          "scope": {
            "enum": [
              "own",
              "department",
              "all"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "department",
          "level",
          "scope"
        ],
        "title": "Membership",
        "type": "object"
      },
      "OwnerLoginIn": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "OwnerLoginIn",
        "type": "object"
      },
      "OwnerMe": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ],
        "title": "OwnerMe",
        "type": "object"
      },
      "Problem": {
        "description": "Problem details (RFC 9457), the body of every error response.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "On 422, one entry per invalid field; otherwise null.",
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "request_id",
          "errors"
        ],
        "title": "Problem",
        "type": "object"
      },
      "PublishOut": {
        "properties": {
          "created": {
            "description": "False when nothing changed since the last publish (no new version).",
            "title": "Created",
            "type": "boolean"
          },
          "deployment_id": {
            "title": "Deployment Id",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "deployment_id",
          "created",
          "sha256"
        ],
        "title": "PublishOut",
        "type": "object"
      },
      "SubmitIn": {
        "properties": {
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "One of the task's outcome ids, when it has outcomes.",
            "title": "Outcome"
          },
          "values": {
            "additionalProperties": true,
            "default": {},
            "title": "Values",
            "type": "object"
          }
        },
        "title": "SubmitIn",
        "type": "object"
      },
      "SubmitOut": {
        "properties": {
          "case_id": {
            "format": "uuid",
            "title": "Case Id",
            "type": "string"
          },
          "release_version": {
            "title": "Release Version",
            "type": "integer"
          },
          "status": {
            "description": "`committed` normally; `pending`/`completed` while a repeated request's first is running.",
            "enum": [
              "pending",
              "completed",
              "committed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "submission_id": {
            "format": "uuid",
            "title": "Submission Id",
            "type": "string"
          }
        },
        "required": [
          "submission_id",
          "status",
          "case_id",
          "release_version"
        ],
        "title": "SubmitOut",
        "type": "object"
      },
      "TaskDetail": {
        "properties": {
          "case": {
            "$ref": "#/components/schemas/CaseOut"
          },
          "editable": {
            "description": "False when the user may only read the task (level 2+ in its department).",
            "title": "Editable",
            "type": "boolean"
          },
          "form": {
            "$ref": "#/components/schemas/FormOut"
          },
          "show": {
            "additionalProperties": true,
            "description": "Read-only values from earlier steps, by field key.",
            "title": "Show",
            "type": "object"
          },
          "task": {
            "$ref": "#/components/schemas/TaskItem"
          }
        },
        "required": [
          "task",
          "case",
          "editable",
          "form",
          "show"
        ],
        "title": "TaskDetail",
        "type": "object"
      },
      "TaskItem": {
        "properties": {
          "assignee": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee"
          },
          "case_code": {
            "title": "Case Code",
            "type": "string"
          },
          "created": {
            "title": "Created",
            "type": "string"
          },
          "flow": {
            "title": "Flow",
            "type": "string"
          },
          "form_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Operaton's form key, `zm:<task id>`.",
            "title": "Form Key"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Key of the stage the task belongs to.",
            "title": "Stage"
          }
        },
        "required": [
          "id",
          "name",
          "flow",
          "case_code",
          "stage",
          "created",
          "assignee",
          "form_key"
        ],
        "title": "TaskItem",
        "type": "object"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "title": "TokenOut",
        "type": "object"
      },
      "WorkspaceIn": {
        "properties": {
          "workspace_code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Workspace Code",
            "type": "string"
          }
        },
        "required": [
          "workspace_code"
        ],
        "title": "WorkspaceIn",
        "type": "object"
      },
      "WorkspaceOut": {
        "properties": {
          "accent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accent"
          },
          "client_name": {
            "title": "Client Name",
            "type": "string"
          },
          "theme": {
            "title": "Theme",
            "type": "string"
          }
        },
        "required": [
          "client_name",
          "theme",
          "accent"
        ],
        "title": "WorkspaceOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Z-Matrix Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/app/cases": {
      "post": {
        "description": "Start a case of one of the workflow's flows, with its start form's values.",
        "operationId": "start_case_app_cases_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Start Case",
        "tags": [
          "app"
        ]
      }
    },
    "/app/me": {
      "get": {
        "description": "The signed-in user and memberships, read on every call so level changes apply at once.",
        "operationId": "me_app_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Me",
        "tags": [
          "app"
        ]
      }
    },
    "/app/tasks": {
      "get": {
        "description": "`mine`: the user's tasks and their groups' unclaimed ones. `team` (level 2+): every task\nof their departments. `flow` and `case` (a case code) narrow the list.",
        "operationId": "list_tasks_app_tasks_get",
        "parameters": [
          {
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "default": "mine",
              "enum": [
                "mine",
                "team"
              ],
              "title": "Scope",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "flow",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Flow"
            }
          },
          {
            "in": "query",
            "name": "case",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Case"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaskItem"
                  },
                  "title": "Response List Tasks App Tasks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "List Tasks",
        "tags": [
          "app"
        ]
      }
    },
    "/app/tasks/{task_id}": {
      "get": {
        "description": "One task with its case, its form as this user sees it, and the values it shows.",
        "operationId": "get_task_app_tasks__task_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Get Task",
        "tags": [
          "app"
        ]
      }
    },
    "/app/tasks/{task_id}/submit": {
      "post": {
        "description": "Submit a task. Send a fresh `Idempotency-Key` per submission; repeating a key returns the\nfirst result instead of submitting again.",
        "operationId": "submit_task_app_tasks__task_id__submit_post",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Submit Task",
        "tags": [
          "app"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh_auth_refresh_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/workspace": {
      "post": {
        "description": "The client behind a workspace code, so the sign-in screen can show its name and look.",
        "operationId": "workspace_auth_workspace_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Workspace",
        "tags": [
          "auth"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Healthz"
      }
    },
    "/owner/auth/login": {
      "post": {
        "operationId": "owner_login_owner_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnerLoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
