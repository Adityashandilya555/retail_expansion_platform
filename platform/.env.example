# ─────────────────────────────────────────────────────────────────────────────
# Z-Matrix / Outpost — environment variables (POC: one pilot client)
# Copy to .env for local dev (gitignored). In deployed envs set each var on the
# platform named in [brackets] via its MCP/CLI — never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ─────────────────────────────────────────────────────────────────
ENVIRONMENT=local                      # local | staging | production   [Railway, Vercel]
PILOT_CLIENT_SLUG=pilot                # registry slug of the POC client         [Railway]

# ── Supabase: PLATFORM project (control plane — created once via Supabase MCP) ─
SUPABASE_PLATFORM_REF=                 # project ref of zm-platform               [Railway: api, worker]
SUPABASE_PLATFORM_URL=https://<ref>.supabase.co
SUPABASE_PLATFORM_SERVICE_ROLE_KEY=    # server only — never in the browser       [Railway]
PLATFORM_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres   # schema "platform" [Railway]
# Data API off, anon has no grants (blueprint §07) → the web app never gets a Supabase key.

# ── Supabase: provisioning of CLIENT projects (worker only) ──────────────────
SUPABASE_ACCESS_TOKEN=                 # Management API personal/org token        [Railway: worker]
SUPABASE_ORG_ID=                       # org that owns client projects            [Railway: worker]
SUPABASE_REGION=ap-south-1             # same region as Railway services
SUPABASE_CLIENT_PLAN=free              # free | pro
# Each client project's ref, DB password, service key and bucket are generated by the worker
# and stored ENCRYPTED in platform.clients — never in env vars.

# ── Local dev only: a client vault on the Supabase CLI (isolation tests) ─────
LOCAL_CLIENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
LOCAL_CLIENT_SLUG=pilot

# ── Operaton (one Railway service per client, started by the worker) ───────
OPERATON_IMAGE=operaton/operaton:<pinned-release>  # release matching the fork base, or our fork build; never "latest" [Railway: worker]
RAILWAY_API_TOKEN=                     # Railway public API token for the worker  [Railway: worker]
RAILWAY_PROJECT_ID=                    # project holding api, worker, operaton-<client> [Railway: worker]
RAILWAY_ENVIRONMENT_ID=                # production / staging environment id      [Railway: worker]
# Per-client Operaton URL + service-account password live ENCRYPTED in platform.clients.
# Env the worker sets on each operaton-<client> service (values from that client's project):
#   DB_DRIVER=org.postgresql.Driver
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?currentSchema=operaton
#   DB_USERNAME=postgres.<client-ref>   DB_PASSWORD=<generated>
#   OPERATON_BPM_AUTHORIZATION_ENABLED=true  OPERATON_BPM_RUN_AUTH_ENABLED=true
#   OPERATON_BPM_RUN_EXAMPLE_ENABLED=false   OPERATON_BPM_HISTORY_LEVEL=full
#   webapps off (run.sh --rest; verify properties in distro/run/assembly/resources/default.yml)
#   resource-id whitelist widened via our image's config file (not env): group/user pattern [a-zA-Z0-9_-]+|operaton-admin — see platform/AGENTS.md "Engine constraints"
# Local dev (docker compose / platform/prototype):
OPERATON_URL=http://localhost:8080/engine-rest
OPERATON_ADMIN_PASSWORD=demo           # platform/prototype matrix.py admin (local only)

# ── Platform API (FastAPI on Railway) ───────────────────────────────────────
API_BASE_URL=http://localhost:8000     # public Railway domain in deployed envs [Vercel: VITE_API_BASE_URL]
JWT_SECRET=                            # openssl rand -hex 32                  [Railway]
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14
SECRETS_ENCRYPTION_KEY=                # Fernet key for client secrets in registry [Railway]
CORS_ALLOWED_ORIGINS=http://localhost:5173   # + Vercel domain             [Railway]

# ── Admin agent (Sprint 2) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=                     #                                       [Railway]
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_TOKENS_PER_CONVERSATION=200000

# ── Email (worker) ──────────────────────────────────────────────────────────
RESEND_API_KEY=                        #                                       [Railway]
EMAIL_FROM="Z-Matrix <noreply@example.com>"

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN_API=                        #                                       [Railway]
SENTRY_DSN_WEB=                        #                                       [Vercel]
LOG_LEVEL=info

# ── Web shell (Vite on Vercel — only VITE_* reach the browser) ──────────────
VITE_API_BASE_URL=http://localhost:8000   #                                    [Vercel]
VITE_SENTRY_DSN=                       #                                       [Vercel]

# ── Tooling (local only, never deployed) ────────────────────────────────────
# GITHUB_PAT=            # only if you prefer env over `gh auth token` for the GitHub MCP
# RAILWAY_TOKEN=         # CI deploys; locally `railway login` is enough
# VERCEL_TOKEN=          # CI deploys; locally OAuth is enough
